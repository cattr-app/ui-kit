{
  "name": "@amazingcat/cattr-ui",
  "version": "0.0.0",
  "description": "A UI Component Library with Vue.js",
  "homepage": "https://cattr.app",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*": "./dist/locale/*.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:package": "pnpm build",
    "build:style": "pnpm --filter cattr-ui-style build",
    "dev": "echo 'docs dev server is not available yet, see .plan/40-docs/40-01' >&2 && exit 1",
    "build:docs": "echo 'docs build is not available yet, see .plan/40-docs/40-01' >&2 && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "github:cattr-app/ui-kit",
  "bugs": {
    "url": "https://github.com/cattr-app/ui-kit/issues"
  },
  "keywords": [
    "cattr",
    "cattr-ui",
    "vue",
    "vue3",
    "ui",
    "components"
  ],
  "files": [
    "dist",
    "src"
  ],
  "author": "Cattr Team <hi@cattr.app>",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "deepmerge": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd"
}
