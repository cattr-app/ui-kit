{
  "name": "at-ui-style",
  "version": "1.5.1",
  "description": "The StyleSheet for AT-UI",
  "scss": "src/index.scss",
  "main": "css/at.css",
  "style": "css/at.css",
  "scripts": {
    "build": "npm run build-clean && npm run copy && npm run build-scss && npm run build-scss-minify && npm run build-autoprefix",
    "build-clean": "rimraf css",
    "build-scss": "sass --style=expanded --source-map src/index.scss css/at.css",
    "build-scss-minify": "sass --style=compressed --source-map src/index.scss css/at.min.css",
    "build-autoprefix": "postcss --use autoprefixer -c postcss.json css/*.css -d css/",
    "copy": "copyfiles -f src/core/fonts/*.* css/fonts/",
    "prepublish": "npm run build",
    "start": "sass --watch --style=expanded --source-map src/index.scss:css/at.css"
  },
  "keywords": [
    "at",
    "at-ui",
    "at-ui-style",
    "css",
    "scss",
    "framework"
  ],
  "author": "Koppt Ho <kopptsoft@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^7.1.1",
    "copyfiles": "^1.2.0",
    "eslint-config-o2team": "^0.1.6",
    "sass": "^1.105.1",
    "postcss-cli": "^4.1.0",
    "rimraf": "^2.6.1"
  }
}
