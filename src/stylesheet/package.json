{
  "name": "cattr-ui-style",
  "private": true,
  "version": "1.5.1",
  "description": "Stylesheet for Cattr UI",
  "scss": "src/index.scss",
  "main": "css/at.css",
  "style": "css/at.css",
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:scss && pnpm run build:scss-minify && pnpm run build:autoprefix",
    "build:clean": "node scripts/clean.mjs",
    "build:scss": "sass --style=expanded --source-map src/index.scss css/at.css",
    "build:scss-minify": "sass --style=compressed --source-map src/index.scss css/at.min.css",
    "build:autoprefix": "postcss css/at.css css/at.min.css --dir css/ --map",
    "start": "sass --watch --style=expanded --source-map src/index.scss:css/at.css"
  },
  "keywords": [
    "cattr",
    "cattr-ui",
    "css",
    "scss",
    "framework"
  ],
  "author": "Cattr Team <hi@cattr.app>",
  "license": "MIT",
  "browserslist": [
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "sass-embedded": "^1.106.1"
  }
}
